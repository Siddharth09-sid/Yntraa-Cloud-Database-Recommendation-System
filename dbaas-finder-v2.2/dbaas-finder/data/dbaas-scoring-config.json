  "substitution_groups": [
    {
      "group": "wide_column_realtime",
      "members": [
        "cassandra",
        "scylladb"
      ],
      "note": "Simulated: ScyllaDB out-scores Cassandra on every technical axis in this matrix (it's engineered specifically to beat Cassandra's JVM/GC-based latency ceiling), so Cassandra will not win on tech score alone. Cassandra becomes the right recommendation when: budget posture is cost-sensitive (Cassandra has an OSS tier, ScyllaDB in this catalog is Enterprise-only), OR the ecosystem answer selects 'prefer_vendor_independent_governance' / plain CQL compatibility without needing Scylla's extra throughput."
    },
    {
      "group": "search_analytics",
      "members": [
        "opensearch",
        "elasticsearch"
      ],
      "note": "Simulated: identical technical scores in every tested scenario (18 vs 18) — these engines solve the same problem equally well. The only legitimate differentiators are budget (OpenSearch OSS vs Elasticsearch Enterprise-only in this catalog) and the compliance/support-SLA answer (Q10) or a stated need for Elastic's commercial ML/ELSER features."
    }
  ],
  "conflict_rules": [
    {
      "id": "offline_sync_vs_massive_scale",
      "when": {
        "Q1_workload_shape": "mobile_edge_offline_sync"
      },
      "tension_with": {
        "Q6_scale": "massive_pb_scale"
      },
      "message": "Offline-first mobile sync and petabyte-scale wide-column storage rarely belong on one engine. This usually means an edge-sync layer (Couchbase Mobile / Sync Gateway) in front of a separate backend store (Cassandra or ScyllaDB) for the bulk data — see the multi-database result instead of forcing a single pick."
    },
    {
      "id": "strict_acid_vs_active_active",
      "when": {
        "Q4_consistency": "strict_acid"
      },
      "tension_with": {
        "Q7_geo_availability": "multi_region_active_active"
      },
      "message": "Strict ACID transactions and multi-region active-active writes are in genuine tension (this is CAP theorem showing up in your answers) — true multi-master strong consistency is hard and expensive everywhere, not just on our platform. Expect a trade-off: either a single-writer region with fast failover, or relaxed consistency specifically on the actively-replicated portion of the data."
    },
    {
      "id": "batch_etl_vs_sub_ms_latency",
      "when": {
        "Q1_workload_shape": "batch_etl_data_lake"
      },
      "tension_with": {
        "Q5_latency": "sub_millisecond"
      },
      "message": "Batch/ETL processing and sub-millisecond live-query latency are different problems by nature. If both are genuinely true, you likely need Hadoop/Spark for the batch layer feeding a separate low-latency serving store (e.g. Redis or ScyllaDB) downstream — not one engine doing both."
    }
  ],
  "multi_app_settings": {
    "strong_fit_threshold": 3,
    "consolidation_min_weight_per_component": 2,
    "note": "strong_fit_threshold picks the best single engine per selected component (from Q1 weights). consolidation_min_weight_per_component is the bar a single engine's weight must clear on EVERY selected component before it's offered as a 'covers it all' consolidation alternative instead of a specialist stack."
  },
  "workload_gate": {
    "question": "Q1_workload_shape",
    "poor_fit_max_weight": 0,
    "penalty": 12,
    "hard_options": {
      "batch_etl_data_lake": 40
    },
    "waived_by": [
      {
        "question": "Q9_ecosystem_compatibility",
        "min_weight": 4
      }
    ],
    "note": "An engine that is a poor fit (weight <= 0) for the described workload loses `penalty` points so it can't win on side features alone. A named compatibility need (Q9 weight >= 4 for that engine, e.g. DynamoDB API) is a hard requirement and waives it. `hard_options` are workloads that form their own category (batch / data lake): the penalty there is much larger and never waived, so the batch specialist always ranks first."
  },
