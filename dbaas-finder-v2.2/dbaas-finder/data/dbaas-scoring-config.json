    "Q10_compliance_edition_modifier": {
      "type": "single_select",
      "note": "Sets the enterprise-requirement flag used in the §5 trade-off logic (forces_enterprise_if) AND, as of this fix, also carries real (modest) per-family weights below. Previously this question had zero effect on WHICH family got recommended — only on which edition of an already-chosen family — which silently contradicted this file's own substitution_groups.search_analytics note (which already claimed Q10 differentiates OpenSearch vs Elasticsearch). Weights are grounded only in each family's own catalog `features` text (native auditing, RBAC, LDAP/Kerberos, TDE/encryption, or an explicit compliance/support-SLA claim) — kept small (max ±3) so compliance nudges the ranking as a secondary signal, the way Q14 (ops comfort) does, rather than overriding the primary workload-fit questions (Q1/Q2).",
      "forces_enterprise_if": "regulated_industry",
      "weights": {
        "standard": {
          "mysql": 0,
          "postgresql": 0,
          "mssql": 0,
          "mariadb": 0,
          "mongodb": 0,
          "redis": 0,
